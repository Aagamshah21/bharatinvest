# BharatInvest Environment Configuration

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./bharatinvest.db
# PostgreSQL for production / Neon / Supabase:
# DATABASE_URL=postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/bharatinvest?sslmode=require

# Application Secrets
SECRET_KEY=bharatinvest-secret-key-change-in-production-2026
SESSION_SECRET=bharatinvest-session-secret-change-in-production-2026

# Google OAuth (OpenID Connect)
# Obtain these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Local development redirect URI:
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Deployed redirect URI:
# GOOGLE_REDIRECT_URI=https://your-domain.onrender.com/auth/google/callback

# New User Defaults
# Starting funds for new Google signups (default: ₹10,00,000)
STARTING_FUNDS=1000000.0
# Whether to seed a starter portfolio for new Google users (default: false)
SEED_STARTER_PORTFOLIO=false

# Access Restrictions (Optional)
# Comma-separated list of allowed emails. Leave empty to allow any Google user.
# ALLOWED_EMAILS=yourname@gmail.com,investor@example.com

# Admin Panel
ADMIN_PASSWORD=admin123
